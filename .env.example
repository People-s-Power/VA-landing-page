# Copy this file to `.env` for local development, and set the same variable in
# Vercel → Project → Settings → Environment Variables for all environments.

# Where the contact form POSTs its leads.
#
# SECURITY: Vite inlines every VITE_* variable into the client JavaScript bundle,
# so this value is PUBLICLY READABLE by anyone who views the page source. Use a
# public intake endpoint (Zapier/Make catch hook, HubSpot public forms endpoint,
# Formspree, etc.) — do NOT put an endpoint here that requires a secret API key.
#
# If your CRM needs a secret, use a serverless function instead; see the note in
# app/lib/crm.ts.
#
# IMPORTANT: this must be set BEFORE the build runs, not just at runtime —
# Vite substitutes the value at build time.
VITE_CRM_ENDPOINT=
